# Copy to .env and fill in the values you need.

# --- LLM (required) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# --- Embeddings (local by default — no key needed) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Reranking (local by default — no key needed) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=career_intelligence

# --- Chunking ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Retrieval ---
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_FINAL_K=5

# --- Uploads ---
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./data/uploads

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Conversation memory (in-process only — resets on restart) ---
MAX_HISTORY_TURNS=10

# --- Server ---
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
