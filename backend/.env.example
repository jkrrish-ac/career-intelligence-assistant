# Copy to .env and fill in the values you need.

# --- LLM (required) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# --- Embeddings (local by default — no key needed) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Reranking (local by default — no key needed) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=career_intelligence

# --- Chunking ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Retrieval ---
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_FINAL_K=5

# --- Query classifier ---
# "llm" asks Claude which uploaded document a question targets (falls back
# to the "heuristic" regex/keyword matcher automatically on any failure or
# timeout); set to "heuristic" to skip the LLM call entirely.
QUERY_CLASSIFIER_MODE=llm
QUERY_CLASSIFIER_TIMEOUT_SECONDS=3.0

# --- Uploads ---
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./data/uploads

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Conversation memory ---
MAX_HISTORY_TURNS=10

# --- Redis (optional) ---
# Leave unset to keep conversation memory and rate limiting in-process
# (fine for a single instance, resets on restart, needs nothing running
# locally). Set this (docker-compose does it automatically) to make both
# durable across restarts and shared across multiple backend instances.
# REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400

# --- Server ---
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
