# Copy to .env at the repo root before running `docker-compose up`.
# This is the only file docker-compose reads; backend/.env.example documents
# the same variables (plus more) for running the backend outside Docker.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Local embeddings/reranking need no key — leave these as-is unless you're
# swapping in a hosted provider (see app/rag/embeddings.py).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true

LOG_LEVEL=INFO
